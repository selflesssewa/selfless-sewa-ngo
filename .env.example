# Environment variables template — copy to .env.local and fill in the values.
# .env*.local is gitignored (safe for secrets); never commit real values.
# For production, set these in Vercel → Settings → Environment Variables.

# --- Contentful (site content / CMS) ---
# Contentful web app → Settings → API keys
CONTENTFUL_SPACE_ID=
CONTENTFUL_ACCESS_TOKEN=

# --- JWT signing secret for payment flow ---
# Any long random string, e.g.  openssl rand -hex 32
JWT_SECRET=

# --- PhonePe one-time (v1 salt-key) — DEPRECATED, no longer used by the code ---
# One-time payments now run on the v2 OAuth creds below. Safe to leave blank.
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=

# --- Neon Postgres (donor ledger + autopay) ---
# Pooled (pgbouncer) — used by app routes & cron.
DATABASE_URL=
# Direct (no pgbouncer) — used by db/migrate.mjs for schema changes.
DATABASE_URL_UNPOOLED=

# --- Admin (donor ledger at /admin) ---
ADMIN_KEY=

# --- Cron protection (used by /api/cron/*; Vercel sends it automatically) ---
CRON_SECRET=

# --- Google Drive receipt archiving (Apps Script Web App) ---
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=

# --- PhonePe v2 OAuth (one-time + Autopay/recurring) ---
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_ENV=                 # SANDBOX (local) | PRODUCTION (live)

# --- Site URL (PhonePe redirect-back target) ---
SITE_URL=                    # http://localhost:3000  |  https://www.selflesssewango.com

# --- Google Analytics 4 (optional; site runs fine without it) ---
NEXT_PUBLIC_GA_ID=           # Measurement ID, e.g. G-XXXXXXXXXX

# --- Production only (not in local dev) ---
# PhonePe webhook Basic-auth — set the SAME pair in the PhonePe dashboard.
# Required in PRODUCTION (the webhook fails closed without them).
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
